# Environment Variables Template
# Copy this file to .env and fill in your actual values

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (Optional - for production storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE=your_service_role_key_here

# Jira Integration (Optional)
JIRA_URL=your_jira_url_here
JIRA_USERNAME=your_jira_username_here
JIRA_API_TOKEN=your_jira_api_token_here

# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Processing Settings
MAX_FILE_SIZE_MB=10
MIN_CLUSTERS=2
MAX_CLUSTERS=10
CHUNK_MAX_LENGTH=2000
EMBEDDING_DIMENSION=768

# Debug Settings
DEBUG_CLUSTERING=true
DEBUG_EMBEDDINGS=true
DEBUG_TEST_GENERATION=true
DEBUG_MODE=true
LOG_LEVEL=debug